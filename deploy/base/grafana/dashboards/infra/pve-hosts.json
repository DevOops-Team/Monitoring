    {
      "type": "table",
      "title": "호스트 요약",
      "description": "가동 시간이 갑자기 짧아졌으면 재부팅된 것(11/06 pve1 재부팅 원인은 미확인). 호스트 이름 ↔ IP: devoops .90 · pve1 .91 · pve2 .92 · pve3 .93 · pve4 .94",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (host) (up{job=\"pve-host\", host=~\"$host\"})",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (host) (time() - node_boot_time_seconds{job=\"pve-host\", host=~\"$host\"})",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "count by (host) (node_cpu_seconds_total{job=\"pve-host\", host=~\"$host\", mode=\"idle\"})",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (host) (node_memory_MemTotal_bytes{job=\"pve-host\", host=~\"$host\"})",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "Value #A": "up",
              "Value #B": "가동 시간",
              "Value #C": "CPU 코어",
              "Value #D": "메모리"
            },
            "indexByName": {
              "host": 0,
              "Value #A": 1,
              "Value #B": 2,
              "Value #C": 3,
              "Value #D": 4
            }
          }
        }
      ],

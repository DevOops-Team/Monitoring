    {
      "type": "table",
      "title": "브로커",
      "description": "브로커 3대(kafka1 .40 · kafka2 .41 · kafka3 .42). 파티션 = 이 브로커가 복제본을 가진 수(복제 3벌이라 셋 다 같음), 리더 = 그중 읽기 · 쓰기를 맡은 수. 리더가 한쪽으로 몰리면 그 브로커만 바쁘다",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (host) (up{job=\"kafka-jmx\"})",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (host) (kafka_controller_kafkacontroller_value{name=\"ActiveControllerCount\"})",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (host) (kafka_server_replicamanager_value{name=\"LeaderCount\"})",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (host) (kafka_server_replicamanager_value{name=\"PartitionCount\"})",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "E",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (host) (process_resident_memory_bytes{job=\"kafka-jmx\"})",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "Value #A": "up",
              "Value #B": "컨트롤러",
              "Value #C": "리더",
              "Value #D": "파티션",
              "Value #E": "메모리(RSS)"
            },
            "indexByName": {
              "host": 0,
              "Value #A": 1,
              "Value #B": 2,
              "Value #C": 3,
              "Value #D": 4,
              "Value #E": 5
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          },
          "noValue": "-"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "컨트롤러"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [

    {
      "type": "table",
      "title": "대상 상태",
      "description": "job마다 정상 수 / 전체 수. cluster가 비어 있는 행 = 모니터링 클러스터 Agent가 LAN에서 직접 긁는 대상(Proxmox · Kafka · blackbox). annotated-pods = prometheus.io/scrape 어노테이션을 단 Pod, namespace로 구분",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (cluster, namespace, job) (up)",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "count by (cluster, namespace, job) (up)",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "Value #A": "정상",
              "Value #B": "전체"
            },
            "indexByName": {
              "cluster": 0,
              "namespace": 1,
              "job": 2,
              "Value #A": 3,
              "Value #B": 4
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"

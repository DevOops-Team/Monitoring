    {
      "type": "stat",
      "title": "게이트웨이 큐 (최대)",
      "description": "OTel 게이트웨이가 Loki · Tempo로 못 보내고 쌓아 둔 비율. 0이 정상, 100%면 새 데이터를 버린다",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(otelcol_exporter_queue_size{cluster=~\"$cluster\"} / otelcol_exporter_queue_capacity{cluster=~\"$cluster\"})"

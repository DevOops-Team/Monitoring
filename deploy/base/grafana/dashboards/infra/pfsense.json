    {
      "type": "stat",
      "title": "인터넷 ping",
      "description": "모니터링 클러스터 → 1.1.1.1 (pfSense WAN 경유). 게이트웨이는 1인데 이것만 0이면 방화벽 바깥(WAN · 회선) 문제",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "probe_success{job=\"blackbox-icmp\", target_name=\"internet\"}"
        }
      ],

    {
      "type": "timeseries",
      "title": "받는 트래픽",
      "description": "초당 바이트(5분). vtnet0 = WAN · vtnet1 = LAN · ipsec1 · ipsec2 = AWS VPN 터널. 터널이 끊기면 ipsec 선이 0으로 내려간다",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "rate(node_network_receive_bytes_total{job=\"pfsense-host\", host=~\"$host\", device=~\"vtnet.*|ipsec.*\"}[5m]) * on (host, device) group_left (description) label_replace(node_pfsense_interface_info{job=\"pfsense-host\", host=~\"$host\"}, \"device\", \"$1\", \"interface\", \"(.+)\")",
          "legendFormat": "{{host}} {{description}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false,
            "thresholdsStyle": {
              "mode": "off"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "transparent",
                "value": null
              }
            ]
          },
          "min": 0
        },
        "overrides": []

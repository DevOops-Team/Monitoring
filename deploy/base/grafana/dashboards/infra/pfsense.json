                "value": null
              },
              {
                "color": "#FF9830",
                "value": 0.8
              },
              {
                "color": "#F2495C",
                "value": 0.9
              }
            ]
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {

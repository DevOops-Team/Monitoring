    {
      "type": "stat",
      "title": "디스크 최대",
      "description": "루트(ZFS) 사용률. 차면 설정 저장이 실패한다. 80% 경고 · 90% 위험(알람 HostDisk*)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(1 - node_filesystem_avail_bytes{job=\"pfsense-host\", host=~\"$host\", mountpoint=\"/\"} / node_filesystem_size_bytes{job=\"pfsense-host\", host=~\"$host\", mountpoint=\"/\"})"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
            "mode": "thresholds"
          },
          "noValue": "-",
          "thresholds": {

    {
      "type": "timeseries",
      "title": "인터페이스 상태",
      "description": "1 = 켜짐. 패키지의 1분 cron이 쓰는 값이라 최대 1분 늦다. AWS_VTI1 · AWS_VTI2는 주 장비에만 있다",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "node_pfsense_interface_up{job=\"pfsense-host\", host=~\"$host\"} * on (host, name) group_left (description, interface) node_pfsense_interface_info",
          "legendFormat": "{{host}} {{description}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false,
            "thresholdsStyle": {
              "mode": "off"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "transparent",
                "value": null
              }
            ]
          },
          "min": 0
        },
        "overrides": []

    {
      "type": "table",
      "title": "장애 목록",
      "description": "장애 1건 = 한 줄. 장애 시작 = 주입 기록(data.injections)이 있으면 주입한 시각, 없으면 고장의 흔적이 처음 생긴 시각(컨테이너 종료 시각 · Xid가 처음 수집된 시각). 출처 칸이 어느 쪽인지 알려 준다: 주입 기록 = 사람이 고장 낸 시각을 넣음(실험) · 자동(신호) = 기록이 없어 흔적 시각을 시작으로 봄(실제 장애는 항상 이쪽) · 옛 데이터 = fault.injected 사건. 감지 = 시작 → 분류기의 첫 알림(gpu.fault). 분류 = 시작 → 분류기가 원인을 확정해 알린 때. 분류기가 처음부터 원인을 알면 사건 한 건으로 끝나 감지와 분류가 같은 값이고, 보류(fault.held)했다가 나중에 원인을 확정(fault.reclassified)한 경우에만 달라진다. 복구 = 원인 확정 → 학습 재개. 신호→첫 알림 = 흔적이 생긴 시각 → 분류기의 첫 알림(수집 · 룰 평가 · 분류기 대기를 합친, 우리 시스템이 쓴 시간). 감지에서 이 값을 빼면 고장이 나고 흔적이 생기기까지의 시간이다",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres"
          },
          "rawSql": "SELECT injected_at, start_source, node, job_id, detect_s, classify_s, recover_s, signal_lag_s, resumed_at FROM data.v_incidents WHERE $__timeFilter(injected_at) ORDER BY injected_at DESC LIMIT 200",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "injected_at": "시작",
              "start_source": "출처",
              "node": "노드",
              "job_id": "작업",
              "detect_s": "감지 (시작→첫 알림)",
              "classify_s": "분류 (시작→원인 확정)",
              "recover_s": "복구 (원인 확정→재개)",
              "signal_lag_s": "신호→첫 알림",
              "resumed_at": "재개 시각"
            },
            "indexByName": {
              "injected_at": 0,
              "start_source": 1,
              "node": 2,
              "job_id": 3,
              "detect_s": 4,
              "classify_s": 5,
              "recover_s": 6,
              "signal_lag_s": 7,
              "resumed_at": 8
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          },
          "noValue": "-"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "^(감지|분류|복구|신호).*"
            },
            "properties": [
              {
                "id": "unit",
                "value": "suffix:초"
              },
              {
                "id": "decimals",
                "value": 1
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "출처"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "manual": {
                        "text": "주입 기록",
                        "index": 0
                      },
                      "signal": {
                        "text": "자동(신호)",
                        "index": 1
                      },
                      "event": {
                        "text": "옛 데이터",
                        "index": 2
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "id": 8,
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 24,
        "h": 9
      }
    },
    {
      "type": "timeseries",
      "title": "감지 · 분류 · 복구 시간",
      "description": "장애 1건 = 점 하나(시작 시각 위치). 감지 = 시작 → 분류기 첫 알림, 분류 = 시작 → 원인 확정, 복구 = 원인 확정 → 재개. 분류기가 처음부터 원인을 알면 사건 한 건으로 끝나 감지와 분류가 같은 값이고, 보류(fault.held)했다가 나중에 원인을 확정(fault.reclassified)한 경우에만 달라진다. 목표와 비교는 SLO-1 측정 때",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres"
          },
          "rawSql": "SELECT injected_at AS time, detect_s AS \"감지\", classify_s AS \"분류\", recover_s AS \"복구\" FROM data.v_incidents WHERE $__timeFilter(injected_at) ORDER BY 1",
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "suffix:초",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "points",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "always",
            "spanNulls": false,
            "thresholdsStyle": {
              "mode": "off"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "transparent",
                "value": null
              }
            ]
          },
          "min": 0,
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 9,
      "gridPos": {

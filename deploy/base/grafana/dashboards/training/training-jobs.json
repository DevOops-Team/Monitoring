          "expr": "max(sum by (cluster, job_id, generation, rank) (rate(train_data_wait_seconds_sum{cluster=~\"$cluster\", job_id=~\"$job_id\", generation=~\"$generation\", phase=\"steady\"}[5m])) / sum by (cluster, job_id, generation, rank) (rate(train_data_wait_seconds_count{cluster=~\"$cluster\", job_id=~\"$job_id\", generation=~\"$generation\", phase=\"steady\"}[5m])))"

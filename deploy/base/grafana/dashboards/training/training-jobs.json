          "expr": "max by (cluster, job_id, generation) (train_stage{cluster=~\"$cluster\", job_id=~\"$job_id\", generation=~\"$generation\", stage=\"init\"} or train_stage{cluster=~\"$cluster\", job_id=~\"$job_id\", generation=~\"$generation\", stage=\"train\"} * 2 or train_stage{cluster=~\"$cluster\", job_id=~\"$job_id\", generation=~\"$generation\", stage=\"checkpoint\"} * 3 or train_stage{cluster=~\"$cluster\", job_id=~\"$job_id\", generation=~\"$generation\", stage=\"finalize\"} * 4)",
          "instant": true,
          "format": "table"

{
  "uid": "training-jobs",
  "title": "학습 작업",
  "tags": [
    "training",
    "trainer",
    "MON-STD-08"
  ],
  "editable": true,
  "schemaVersion": 39,
  "version": 1,
  "timezone": "browser",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "30s",
  "graphTooltip": 1,
  "annotations": {
    "list": []
  },
  "links": [],
  "templating": {
    "list": [
      {
        "name": "cluster",
        "label": "클러스터",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(train_current_step, cluster)",
          "refId": "var"
        },
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "job_id",
        "label": "작업",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(train_current_step{cluster=~\"$cluster\"}, job_id)",
          "refId": "var"
        },
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "generation",
        "label": "세대",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(train_current_step{cluster=~\"$cluster\", job_id=~\"$job_id\"}, generation)",
          "refId": "var"
        },
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "type": "stat",
      "title": "학습 작업",
      "description": "지표를 내고 있는 작업(job_id · 세대) 수",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "count(count by (job_id, generation) (train_current_step{cluster=~\"$cluster\", job_id=~\"$job_id\", generation=~\"$generation\"})) or vector(0)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "noValue": "-",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#73BF69",
                "value": null
              }
            ]
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto",
        "justifyMode": "auto",
        "text": {
          "valueSize": 36
        }
      },
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      }
    },
    {
      "type": "stat",
      "title": "스텝 평균",
      "description": "한 step에 걸린 시간(steady 구간, 5분 평균). 작업이 여러 개면 그 평균. 버킷이 성겨 분위수 대신 평균(sum ÷ count)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "avg(sum by (cluster, job_id, generation) (rate(train_step_seconds_sum{cluster=~\"$cluster\", job_id=~\"$job_id\", generation=~\"$generation\", phase=\"steady\"}[5m])) / sum by (cluster, job_id, generation) (rate(train_step_seconds_count{cluster=~\"$cluster\", job_id=~\"$job_id\", generation=~\"$generation\", phase=\"steady\"}[5m])))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "thresholds"
          },
          "noValue": "-",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#73BF69",
                "value": null
              }
            ]
          },
          "mappings": [],
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto",
        "justifyMode": "auto",
        "text": {
          "valueSize": 36
        }
      },
      "id": 2,
      "gridPos": {
        "x": 4,
        "y": 0,
        "w": 4,
        "h": 4
      }
    },
    {
      "type": "stat",
      "title": "스트래글러",
      "description": "가장 느린 랭크의 GPU 계산 시간 ÷ 랭크 중앙값(MON-STD-08). 1.0 = 정상 · 1.5 이상 2분 = 경고 · 2.0 = 위험",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(train_rank_compute_seconds{cluster=~\"$cluster\", job_id=~\"$job_id\", generation=~\"$generation\"} / on (job_id, generation) group_left quantile by (job_id, generation) (0.5, train_rank_compute_seconds{cluster=~\"$cluster\", job_id=~\"$job_id\", generation=~\"$generation\"}))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "thresholds"
          },
          "noValue": "-",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#73BF69",
                "value": null
              },
              {
                "color": "#FF9830",
                "value": 1.5
              },
              {
                "color": "#F2495C",
                "value": 2
              }
            ]
          },
          "mappings": [],
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"

        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (cluster, job_id, generation) (train_last_checkpoint_step{cluster=~\"$cluster\", job_id=~\"$job_id\", generation=~\"$generation\"})",

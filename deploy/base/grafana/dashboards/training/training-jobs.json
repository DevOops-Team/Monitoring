          "expr": "sum by (cluster, job_id, generation) (rate(train_step_seconds_sum{cluster=~\"$cluster\", job_id=~\"$job_id\", generation=~\"$generation\", phase=\"steady\"}[5m])) / sum by (cluster, job_id, generation) (rate(train_step_seconds_count{cluster=~\"$cluster\", job_id=~\"$job_id\", generation=~\"$generation\", phase=\"steady\"}[5m]))",

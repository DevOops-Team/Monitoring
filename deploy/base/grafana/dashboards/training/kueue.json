  "panels": [
    {
      "type": "stat",
      "title": "대기",
      "description": "쿼터를 못 받아 기다리는 Workload 수(전체 큐 합). 관리 클러스터 기준(위 cluster 변수와 상관없음): 워커(EKS)의 Workload는 관리 클러스터 것의 복제라 합치면 두 번 센다",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(max by (cluster, cluster_queue, status) (kueue_pending_workloads{cluster=\"onprem-manager\", replica_role=\"leader\"})) or vector(0)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "noValue": "-",
          "thresholds": {
            "mode": "absolute",

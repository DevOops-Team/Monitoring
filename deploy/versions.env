# Grafana · Loki · Tempo 차트는 2026-01부터 grafana-community/helm-charts로 이전됨(옛 grafana/* 는 deprecated).
# 레포 등록: helm repo add grafana-community https://grafana-community.github.io/helm-charts/
#            helm repo add prometheus-community https://prometheus-community.github.io/helm-charts
#            helm repo add containeroo https://charts.containeroo.ch
# 차트·이미지 버전. scripts/deploy-k8s.sh(비상 · 처음 설치 · lint)가 읽는다. 올릴 때는 kind에서 먼저 확인
# 평소 배포는 ArgoCD라서 *_CHART 값은 Gitops 레포 bootstrap/onprem/applications/gpu-monitoring-*.yaml의 targetRevision과 같이 고친다(두 곳)
LOCAL_PATH_CHART=0.0.38                 # containeroo/local-path-provisioner (app v0.0.37)
NODE_EXPORTER_CHART=5.0.0               # prometheus-community/prometheus-node-exporter (app 1.12.1)
ALERTMANAGER_CHART=2.3.1                # prometheus-community/alertmanager (app v0.34.2, compose와 같음)
GRAFANA_CHART=14.4.0                    # grafana-community/grafana (app 13.3.0 = compose와 같음)
LOKI_CHART=21.0.0                       # grafana-community/loki (app 3.7.9)
TEMPO_CHART=3.2.1                       # grafana-community/tempo (app 3.1.1, single binary)
BLACKBOX_CHART=11.21.1                  # prometheus-community/prometheus-blackbox-exporter (app v0.29.1)
KAFKA_EXPORTER_CHART=4.1.1              # prometheus-community/prometheus-kafka-exporter (app v1.11.0). 4.1.2는 2026-11-07 출시라 한 판 묵힌다
POSTGRES_EXPORTER_CHART=8.2.2           # prometheus-community/prometheus-postgres-exporter (app v0.20.1). 8.2.3부터는 2026-11-05 이후 출시라 묵힌다
KSM_CHART=8.8.0                         # prometheus-community/kube-state-metrics (app v2.20.0 = 아래 KSM_IMAGE와 같게)
# 자체 매니페스트 이미지(base/ 안 YAML에 직접 적혀 있음. lint용으로만 여기 둔다)
MIMIR_IMAGE=grafana/mimir:3.2.4
PROMETHEUS_IMAGE=prom/prometheus:v3.15.1
ALERTMANAGER_IMAGE=prom/alertmanager:v0.34.2
CREDENTIAL_HELPER_IMAGE=public.ecr.aws/rolesanywhere/credential-helper:1.8.5-2026.08.24.20.52   # S3 임시 키 사이드카. 1.8.6은 2026-11-04 출시라 한 판 묵힌다
# 수집 층(deploy/agents/, 관리 클러스터 · EKS에 올리는 것)
KSM_IMAGE=registry.k8s.io/kube-state-metrics/kube-state-metrics:v2.20.0
FLUENT_BIT_IMAGE=fluent/fluent-bit:5.1.1                                   # v5.2.0은 2026-11-09 출시라 한 판 묵힌다
OTEL_COLLECTOR_IMAGE=otel/opentelemetry-collector-contrib:0.164.0           # transform · file_storage는 contrib에만 있다
NODE_EXPORTER_IMAGE=quay.io/prometheus/node-exporter:v1.12.1               # 모니터링 클러스터 차트(NODE_EXPORTER_CHART)의 app 버전과 같게
INIT_IMAGE=busybox:1.37.0                                                 # hostPath chown용 initContainer
DCGM_EXPORTER_IMAGE=nvcr.io/nvidia/k8s/dcgm-exporter:4.6.1-4.8.4-distroless   # deploy/agents/gpu. 4.8.4 고정(4.9.0부터 지표 이름 · 단위 변경, docs/monitoring-standard.md 4.1)

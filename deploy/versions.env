# Grafana · Loki · Tempo 차트는 2026-01부터 grafana-community/helm-charts로 이전됨(옛 grafana/* 는 deprecated).
# 레포 등록: helm repo add grafana-community https://grafana-community.github.io/helm-charts/
#            helm repo add prometheus-community https://prometheus-community.github.io/helm-charts
#            helm repo add containeroo https://charts.containeroo.ch
# 차트·이미지 버전을 한 곳에. scripts/deploy-k8s.sh가 읽는다. 올릴 때는 여기만 고치고 kind에서 먼저 확인
LOCAL_PATH_CHART=0.0.38                 # containeroo/local-path-provisioner (app v0.0.37)
NODE_EXPORTER_CHART=5.0.0               # prometheus-community/prometheus-node-exporter (app 1.12.1)
ALERTMANAGER_CHART=2.3.1                # prometheus-community/alertmanager (app v0.34.2, compose와 같음)
GRAFANA_CHART=14.4.0                    # grafana-community/grafana (app 13.3.0 = compose와 같음)
LOKI_CHART=21.0.0                       # grafana-community/loki (app 3.7.9)
TEMPO_CHART=3.2.1                       # grafana-community/tempo (app 3.1.1, single binary)
BLACKBOX_CHART=11.21.1                  # prometheus-community/prometheus-blackbox-exporter (app v0.29.1)
# 자체 매니페스트 이미지(base/ 안 YAML에 직접 적혀 있음. lint용으로만 여기 둔다)
MIMIR_IMAGE=grafana/mimir:3.2.4
PROMETHEUS_IMAGE=prom/prometheus:v3.15.1
ALERTMANAGER_IMAGE=prom/alertmanager:v0.34.2

  "panels": [
    {
      "type": "stat",
      "title": "GPU 수",
      "description": "dcgm-exporter가 보고하는 GPU 수(노드당 1장). 학습 4 + 예비 1 = 클러스터당 5",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "count(max by (cluster, node, gpu) (DCGM_FI_DEV_GPU_TEMP{cluster=~\"$cluster\", node=~\"$node\"})) or vector(0)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"

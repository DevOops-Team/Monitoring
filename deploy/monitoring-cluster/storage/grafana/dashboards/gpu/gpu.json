    {
      "type": "timeseries",
      "title": "GPU 온도",
      "description": "점선 = GPU가 스스로 보고하는 한계(가장 낮은 GPU 값). T4 = 최대 동작 85 · 감속 93 · 차단 96°C(11/19 측정). 최대 동작 이상 = 경고, 감속 이상 = 위험",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (cluster, node, gpu) (DCGM_FI_DEV_GPU_TEMP{cluster=~\"$cluster\", node=~\"$node\"})",
          "legendFormat": "{{cluster}} {{node}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "min(DCGM_FI_DEV_GPU_MAX_OP_TEMP{cluster=~\"$cluster\", node=~\"$node\"})",
          "legendFormat": "한계: 최대 동작"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "min(DCGM_FI_DEV_SLOWDOWN_TEMP{cluster=~\"$cluster\", node=~\"$node\"})",
          "legendFormat": "한계: 감속"
        },
        {
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "min(DCGM_FI_DEV_SHUTDOWN_TEMP{cluster=~\"$cluster\", node=~\"$node\"})",
          "legendFormat": "한계: 차단"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "color": {
            "mode": "palette-classic"
